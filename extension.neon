parameters:
    universalObjectCratesClasses:
        - PHPUnit\Framework\TestCase
    scanDirectories:
        - src
    stubFiles:
        - stubs/DescribeCall.stub

services:
    -
        class: Pest\PHPStan\Type\Pest\PestFileDiscoverer
        arguments:
            scanPaths: %paths%
            rootDir: %currentWorkingDirectory%

    -
        class: Pest\PHPStan\Type\Pest\PestConfigReader

    -
        class: Pest\PHPStan\Analysis\Expectation\ExpectationMatcherRegistry

    -
        class: Pest\PHPStan\Analysis\Expectation\ExpectationTypeNarrower

    -
        class: Pest\PHPStan\Analysis\Expectation\ExpectationChainStateResolver

    -
        class: Pest\PHPStan\Analysis\Expectation\ExpectationSemanticAnalyzer

    -
        class: Pest\PHPStan\Type\Pest\PestFunctionReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension

    -
        class: Pest\PHPStan\Type\Pest\ExpectationMethodReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension

    -
        class: Pest\PHPStan\Type\Pest\OppositeExpectationMethodReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension

    -
        class: Pest\PHPStan\Type\Pest\PestTestCaseType

    -
        class: Pest\PHPStan\Type\Pest\TestClosureThisTypeExtension
        tags:
            - phpstan.functionParameterClosureThisExtension

    -
        class: Pest\PHPStan\Type\Pest\WithClosureThisTypeExtension
        tags:
            - phpstan.methodParameterClosureThisExtension

    -
        class: Pest\PHPStan\Type\Pest\UsesHookClosureThisTypeExtension
        tags:
            - phpstan.methodParameterClosureThisExtension

    -
        class: Pest\PHPStan\Type\Pest\WithDatasetClosureNodeVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor

    -
        class: Pest\PHPStan\Type\Pest\ExpectationPropertiesExtension
        tags:
            - phpstan.broker.propertiesClassReflectionExtension

    -
        class: Pest\PHPStan\Type\Pest\PestHookPropertyReader

    -
        class: Pest\PHPStan\Type\Pest\TestCaseDynamicPropertyTypeExtension
        tags:
            - phpstan.broker.expressionTypeResolverExtension

    -
        class: Pest\PHPStan\Type\Pest\HigherOrderExpectationTypeExtension
        tags:
            - phpstan.broker.expressionTypeResolverExtension

    -
        class: Pest\PHPStan\Type\Pest\PestInternalClassAccessIgnoreExtension
        tags:
            - phpstan.ignoreErrorExtension

    -
        class: Pest\PHPStan\Type\Pest\ArchExpectationPropertyIgnoreExtension
        tags:
            - phpstan.ignoreErrorExtension

    -
        class: Pest\PHPStan\Type\Pest\TestCallMethodsClassReflectionExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension

    -
        class: Pest\PHPStan\Type\Pest\ProtectedMethodCallIgnoreExtension
        tags:
            - phpstan.ignoreErrorExtension

    -
        class: Pest\PHPStan\Type\Pest\HigherOrderExpectationMethodIgnoreExtension
        tags:
            - phpstan.ignoreErrorExtension

    -
        class: Pest\PHPStan\Rules\InvalidThrowsExceptionRule
        arguments:
            reflectionProvider: @reflectionProvider
        tags:
            - phpstan.rules.rule

    -
        class: Pest\PHPStan\Rules\CoversClassExistsRule
        arguments:
            reflectionProvider: @reflectionProvider
        tags:
            - phpstan.rules.rule

rules:
    - Pest\PHPStan\Rules\DisallowedCallInDescribeRule
    - Pest\PHPStan\Rules\StaticTestClosureRule
    - Pest\PHPStan\Rules\RepeatWithInvalidValueRule
    - Pest\PHPStan\Rules\DuplicateTestDescriptionRule
    - Pest\PHPStan\Rules\ImpossibleExpectationRule
    - Pest\PHPStan\Rules\RedundantExpectationRule
    - Pest\PHPStan\Rules\ExpectationValueTypeRule
    - Pest\PHPStan\Rules\EmptyTestClosureRule
    - Pest\PHPStan\Rules\BeforeAllThisUsageRule
    - Pest\PHPStan\Rules\DescribeWithoutTestsRule
    - Pest\PHPStan\Rules\InvalidGroupNameRule
    - Pest\PHPStan\Rules\RedundantLocalUseRule
